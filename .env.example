# ---------------------------------------------------------------------------
# AI Incident Investigator - server configuration
# Copy to .env.local. Every value here is server-only: nothing is exposed to
# the browser (there are no NEXT_PUBLIC_ variables).
# ---------------------------------------------------------------------------

# Supabase - reuse the existing project. These names and values are the same
# as ../live-location-tracker/server/.env (SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SECRET_KEY, DATABASE_URL), so copy them across unchanged.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key. Used by the background investigation runner only.
SUPABASE_SECRET_KEY=
# Only needed for `npm run db:migrate`. Use the session pooler (port 5432).
DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Public URL of this app (used for auth redirect URLs). Optional locally.
# APP_URL=http://localhost:3000

# AI provider ----------------------------------------------------------------
# anthropic (default) or gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro

# GitHub ---------------------------------------------------------------------
# Fine-grained PAT, read-only: Repository permissions -> Contents: Read,
# Metadata: Read (and nothing else), limited to the repositories to investigate.
GITHUB_TOKEN=
# Optional separate token used ONLY to create branches/commits/PRs after the
# user confirms: Contents: Read and write, Pull requests: Read and write.
# Falls back to GITHUB_TOKEN when unset.
GITHUB_WRITE_TOKEN=
# Optional comma-separated allow-list of repository owners (users/orgs).
# GITHUB_ALLOWED_OWNERS=my-org,my-user

# Test execution -------------------------------------------------------------
# When true, run_tests executes the repository's configured test command in a
# temporary copy of the repository ON THIS SERVER. Only enable for trusted
# repositories, ideally inside a container. Secrets are not passed to the
# child process and no shell is used.
ENABLE_TEST_EXECUTION=false
TEST_TIMEOUT_SECONDS=120

# Agent limits (guards against runaway investigations) -----------------------
AGENT_MAX_STEPS=30
AGENT_MAX_TOOL_CALLS=60
AGENT_MAX_TOKENS=1500000
AGENT_MAX_DURATION_SECONDS=600
TOOL_TIMEOUT_SECONDS=45
MAX_REPO_ARCHIVE_MB=150
